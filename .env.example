# ==============================================================================
# HONWORTH WEALTH ADVISORY - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env.local' and supply your production/development keys.
# ==============================================================================

# 1. Custom Administration Security Session Secret (Mandatory)
# Run `openssl rand -base64 32` to generate a strong cryptographically secure secret.
SESSION_SECRET=your-cryptographically-secure-base64-secret-here

# 2. Database Configuration (Hostinger MySQL Server)
DB_HOST=srv1991.hstgr.io
DB_PORT=3306
DB_USER=your_mysql_database_username
DB_PASSWORD=your_mysql_database_password
DB_NAME=your_mysql_database_name

# 3. SMTP Mail Configuration (Nodemailer / Contact Form / Signup Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sender_gmail_address
SMTP_PASS=your_gmail_app_specific_password
CONTACT_EMAIL=rahul.karandikar@honworth.in

# 4. Redis Rate Limiting (Upstash Serverless Redis REST API)
UPSTASH_REDIS_REST_URL=https://your-redis-instance-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_api_bearer_token
